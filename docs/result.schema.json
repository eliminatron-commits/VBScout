{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vbscout.example/schema/result-1.json",
  "title": "Result file content (result.json), schema version 1",
  "description": "What one collector run on one machine found. Readers must ignore unknown properties and keep unknown values of open enumerations (additive changes keep schemaVersion). See docs/result-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "scanId", "generator", "startedAt", "finishedAt", "machine", "scope", "coverage"],
  "properties": {
    "format": { "type": "string", "pattern": "^application/[a-z0-9.+-]+\\+zip$", "description": "Media type, identical to the mimetype entry." },
    "schemaVersion": { "const": 1 },
    "scanId": { "type": "string", "format": "uuid" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "component", "version", "rulesAsOf", "platform"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "component": { "const": "collector" },
        "version": { "type": "string", "minLength": 1 },
        "rulesAsOf": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "platform": { "type": "string", "minLength": 1 }
      }
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "os"],
      "properties": {
        "hostname": { "type": "string", "minLength": 1 },
        "fqdn": { "type": "string" },
        "domain": { "type": "string" },
        "machineId": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 over the Windows MachineGuid (pseudonymous)." },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family"],
          "properties": {
            "family": { "type": "string", "minLength": 1 },
            "name": { "type": "string" },
            "version": { "type": "string" },
            "build": { "type": "integer", "minimum": 0 },
            "displayVersion": { "type": "string" },
            "edition": { "type": "string" },
            "productType": { "$ref": "#/$defs/openEnum", "description": "workstation | server | domainController" },
            "architecture": { "type": "string" }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localDrives", "systemSources"],
      "properties": {
        "localDrives": { "type": "boolean" },
        "paths": { "type": "array", "items": { "type": "string" } },
        "networkPaths": { "type": "array", "items": { "type": "string" } },
        "systemSources": { "type": "boolean" }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "elevated"],
      "properties": {
        "mode": { "$ref": "#/$defs/openEnum", "description": "full | limited" },
        "elevated": { "type": "boolean" },
        "limitations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": { "$ref": "#/$defs/openEnum", "description": "notElevated | systemSourcesSkipped | fileScopeRestricted | sourceIncomplete | unsupportedPlatform" },
              "detail": { "type": "string" }
            }
          }
        },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceCoverage" } }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "openEnum": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$",
      "description": "camelCase value of an open enumeration; unknown values come from newer versions and must be kept."
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "status"],
      "properties": {
        "source": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$", "description": "e.g. files.localDrives, files.paths, files.networkPaths, registry.autostart, eventLog.application" },
        "status": { "$ref": "#/$defs/openEnum", "description": "complete | partial | skipped | unavailable | failed" },
        "reason": { "type": "string" },
        "roots": { "type": "array", "items": { "type": "string" } },
        "entries": { "type": "integer", "minimum": 0 },
        "inspected": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "errorSamples": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
        "durationMs": { "type": "integer", "minimum": 0 },
        "timeRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "format": "date-time" },
            "to": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule", "kind", "classification", "status", "activation", "location"],
      "properties": {
        "id": { "type": "string", "pattern": "^f[1-9][0-9]*$" },
        "rule": { "type": "string", "pattern": "^VBS-[0-9]{3}$" },
        "kind": { "$ref": "#/$defs/openEnum", "description": "scriptFile | scriptInvocation | shortcut | scheduledTask | autostart | service | wmiSubscription | logonScript | msiCustomAction | eventLogUsage | officeMacro | hardcodedCredential" },
        "classification": { "$ref": "#/$defs/openEnum", "description": "breaks | review (unknown values are treated as review)" },
        "status": { "$ref": "#/$defs/openEnum", "description": "detected | notCheckable" },
        "reason": { "$ref": "#/$defs/openEnum", "description": "Only for notCheckable: passwordProtected | accessDenied | locked | corrupt | unsupportedFormat | tooLarge | cloudPlaceholder | encrypted | internalError" },
        "activation": { "$ref": "#/$defs/openEnum", "description": "automatic | logged | macro | installer | manual | dormant" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path"],
          "properties": {
            "type": { "$ref": "#/$defs/openEnum", "description": "file | registry | scheduledTask | service | wmi | eventLog | msiPackage" },
            "path": { "type": "string", "minLength": 1 },
            "item": { "type": "string" }
          }
        },
        "target": { "type": "string" },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["size"],
          "properties": {
            "size": { "type": "integer", "minimum": 0 },
            "modifiedAt": { "type": "string", "format": "date-time" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "network": { "type": "boolean" }
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "line": { "type": "integer", "minimum": 1 },
              "text": { "type": "string", "maxLength": 240 },
              "masked": { "type": "boolean" }
            }
          }
        },
        "details": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "type": ["string", "integer", "boolean"] }
        }
      },
      "if": { "properties": { "status": { "const": "notCheckable" } } },
      "then": { "required": ["reason"] },
      "else": { "not": { "required": ["reason"] } }
    }
  }
}
